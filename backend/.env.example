# --- Base de datos ---
# Usar el connection pooler de Supabase (puerto 6543, modo "Transaction"), NO la conexión
# directa (5432): en serverless cada invocación es una conexión nueva y el pooler evita
# agotar los slots de Postgres. Ver core/database.py.
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres

# --- Auth ---
# Sin default a propósito: si falta, la app debe fallar al arrancar en vez de firmar
# tokens con un secreto predecible.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Encriptación de datos financieros (ver app/core/encryption.py) ---
# Sin default a propósito, igual criterio que JWT_SECRET: montos/categorías/historial
# de wallets, transactions, debts e installments se guardan encriptados con esta clave
# (Fernet/AES) — ni un admin mirando la tabla directo debe poder leerlos en texto plano.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRÍTICO: si esta clave se pierde o rota sin re-encriptar los datos existentes, esos
# datos quedan ilegibles para siempre — hacer backup de esta clave por separado de la DB.
MASTER_ENCRYPTION_KEY=

# --- Beta cerrada ---
# Límite de usuarios activos para no sobrecargar el servidor mientras es gratis/beta.
# Extensible sin tocar código: solo subir este número.
MAX_BETA_USERS=50

# --- CORS / origen permitido ---
FRONTEND_URL=http://localhost:5173

# --- Cloudflare Turnstile (anti-bot en /register y /login, ver app/shared/turnstile.py) ---
# En false (default), /register y /login funcionan igual que siempre, sin pedir
# ninguna verificación. Para activarlo de verdad: creá un widget en
# dash.cloudflare.com -> Turnstile -> Add site (modo "Managed" está bien), copiá su
# "Secret Key" acá, y su "Site Key" en frontend/.env como VITE_TURNSTILE_SITE_KEY
# (esa sí es pública, va al navegador). Recién ahí poné esto en true.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# --- Login con Google (ver app/shared/google_auth.py) ---
# Vacío = /api/auth/google rechaza todo. Para activarlo: console.cloud.google.com ->
# crear un proyecto -> APIs & Services -> Credentials -> Create Credentials -> OAuth
# client ID -> tipo "Web application" -> en "Authorized JavaScript origins" agregá tu
# dominio (y http://localhost:5173 para probar en dev). Copiá el "Client ID" (termina
# en .apps.googleusercontent.com) acá Y en frontend/.env como
# VITE_GOOGLE_CLIENT_ID (mismo valor en los dos lados, es público). No hace falta
# ningún "Client Secret" - el flujo de Google Identity Services no lo usa.
GOOGLE_CLIENT_ID=

# --- Tasas de cambio (fiat) ---
# NOTA: cliente todavía sin conectar en esta primera pasada (ver README, sección
# "APIs externas: qué se conecta y qué no"). Dejar documentado para cuando se active.
OPEN_EXCHANGE_RATES_APP_ID=
CURRENCY_CACHE_TTL_HOURS=24

# --- Voz a texto ---
# Sin variable acá a propósito: la transcripción ocurre en el navegador vía la Web
# Speech API (ver frontend/.env.example), el backend nunca recibe audio.

# --- OCR de recibos ---
# NOTA: cliente todavía sin conectar en esta primera pasada.
OCR_PROVIDER_API_KEY=

# --- Push notifications (VAPID) ---
# NOTA: dominio "notifications" se construye de último. Generar con `vapid --gen` o
# `pywebpush` cuando se llegue a esa fase.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# --- Cron (Vercel) ---
# Secreto compartido para validar que /api/cron/* solo lo invoque Vercel Cron, no
# cualquiera que adivine la URL.
CRON_SECRET=

ENVIRONMENT=development

# --- Modo demo (solo para pruebas visuales locales, NUNCA activar en producción) ---
# En true, /api/auth/login acepta cualquier email/password y siempre entra al mismo
# usuario demo con wallets/transacciones/deudas de ejemplo ya cargadas. Se ignora por
# completo si ENVIRONMENT=production (ver Settings.fake_data_mode_active), como
# protección extra aunque alguien deje esta variable prendida por error en prod.
FAKE_DATA_MODE=false
