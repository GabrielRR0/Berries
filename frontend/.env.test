# Vite carga .env.test ADEMAS de .env en modo test (este archivo gana para las claves
# que repite) - sin esto, los tests de GoogleSignInButton/TurnstileWidget que verifican
# el comportamiento "apagado por default" dependen por accidente de si el .env local de
# quien corre los tests tiene una site key/client id real cargada (ver
# backend/tests/conftest.py, mismo problema y mismo criterio del lado del backend).
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
