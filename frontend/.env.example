# Sin valor, queda '' y las rutas quedan relativas ('/api/...'): funciona en
# dev via el proxy de vite.config.ts (/api -> http://localhost:8002 — puerto propio
# de Berry, no 8000, para no chocar con el backend de otro proyecto hermano corriendo
# a la vez). En produccion (frontend y backend en dominios distintos), se define esta
# variable con la URL real del backend desplegado.
VITE_API_BASE_URL=

# Idioma para el reconocimiento de voz del navegador (Web Speech API, ver
# VoiceRecorderModal.vue) — cambiar acá, no hardcodeado en el componente.
VITE_VOICE_RECOGNITION_LANG=es-419

# --- Cloudflare Turnstile (ver TurnstileWidget.vue) ---
# Site key PÚBLICA del widget (distinta de la Secret Key, que va en backend/.env y
# nunca acá). Vacía por default: TurnstileWidget.vue no renderiza nada y ningún
# formulario exige un token hasta que se complete esta variable (debe coincidir con
# TURNSTILE_ENABLED=true del lado del backend para que la verificación sea real).
VITE_TURNSTILE_SITE_KEY=

# --- Login con Google (ver GoogleSignInButton.vue) ---
# Client ID PÚBLICO (termina en .apps.googleusercontent.com) - mismo valor que
# GOOGLE_CLIENT_ID en backend/.env, ver ese archivo para cómo conseguirlo. Vacío por
# default: el botón "Continuar con Google" no aparece hasta que se complete.
VITE_GOOGLE_CLIENT_ID=
